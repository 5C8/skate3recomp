# Label existing generated functions without adding SDK analysis entries.
function(_skate3_apply_deferred_names)
  set(_table "${SKATE3_SOURCE_DIR}/config/skate3_bridge_deferred_names.toml")
  if(NOT EXISTS "${_table}")
    return()
  endif()
  file(READ "${SKATE3_SOURCE_DIR}/generated/skate3_init.cpp" _init)
  file(STRINGS "${_table}" _entries REGEX [=[^"0x]=])
  set(_active)
  foreach(_entry IN LISTS _entries)
    if(NOT _entry MATCHES [=[^"0x([0-9A-Fa-f]+)" = [{] name = "([A-Za-z_][A-Za-z0-9_]*)" [}]$]=])
      message(FATAL_ERROR "Malformed deferred Skate 3 name: ${_entry}")
    endif()
    string(TOUPPER "${CMAKE_MATCH_1}" _address)
    set(_name "${CMAKE_MATCH_2}")
    string(LENGTH "${_address}" _length)
    if(NOT _length EQUAL 8)
      message(FATAL_ERROR "Deferred Skate 3 address must have eight hex digits")
    endif()
    if(DEFINED _map_${_address} AND NOT "${_map_${_address}}" STREQUAL "${_name}")
      message(FATAL_ERROR "Conflicting deferred Skate 3 names at ${_address}")
    endif()
    string(REGEX MATCH "0x${_address},[ \t\r\n]*([A-Za-z_][A-Za-z0-9_]*)" _binding "${_init}")
    if(_binding STREQUAL "")
      continue() # A TU-only function may be absent in another configuration.
    endif()
    set(_actual "${CMAKE_MATCH_1}")
    if(NOT _actual STREQUAL "sub_${_address}" AND NOT _actual STREQUAL "${_name}")
      message(FATAL_ERROR "Existing Skate 3 label conflicts at ${_address}: ${_actual}")
    endif()
    set(_map_${_address} "${_name}")
    list(APPEND _active "${_address}")
  endforeach()
  list(REMOVE_DUPLICATES _active)
  if(NOT _active)
    return()
  endif()
  string(JOIN "|" _address_union ${_active})
  file(GLOB _files LIST_DIRECTORIES false
    "${SKATE3_SOURCE_DIR}/generated/skate3*.cpp"
    "${SKATE3_SOURCE_DIR}/generated/skate3*.h")
  foreach(_file IN LISTS _files)
    file(READ "${_file}" _contents)
    set(_before "${_contents}")
    string(REGEX MATCHALL "(__imp__)?sub_(${_address_union})" _tokens "${_contents}")
    list(REMOVE_DUPLICATES _tokens)
    foreach(_token IN LISTS _tokens)
      if(NOT _token MATCHES "^(__imp__)?sub_([0-9A-Fa-f]+)$")
        continue()
      endif()
      set(_prefix "${CMAKE_MATCH_1}")
      string(TOUPPER "${CMAKE_MATCH_2}" _address)
      if(NOT DEFINED _map_${_address})
        continue()
      endif()
      set(_replacement "${_prefix}${_map_${_address}}")
      # Two passes also cover adjacent occurrences sharing a delimiter.
      foreach(_pass RANGE 1 2)
        string(REGEX REPLACE "(^|[^A-Za-z0-9_])${_token}([^A-Za-z0-9_]|$)"
          "\\1${_replacement}\\2" _contents "${_contents}")
      endforeach()
    endforeach()
    if(NOT _before STREQUAL _contents)
      file(WRITE "${_file}" "${_contents}")
    endif()
  endforeach()
  file(READ "${SKATE3_SOURCE_DIR}/generated/skate3_init.cpp" _init)
  foreach(_address IN LISTS _active)
    string(REGEX MATCH "0x${_address},[ \t\r\n]*([A-Za-z_][A-Za-z0-9_]*)" _binding "${_init}")
    if(NOT "${CMAKE_MATCH_1}" STREQUAL "${_map_${_address}}")
      message(FATAL_ERROR "Deferred Skate 3 name did not resolve at ${_address}")
    endif()
  endforeach()
  list(LENGTH _active _count)
  message(STATUS "Applied ${_count} deferred Skate 3 function labels")
endfunction()
_skate3_apply_deferred_names()
